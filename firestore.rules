rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function currentUserDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && (currentUserDoc().role in ['admin', 'Admin', 'ADMIN'])
        && (!('isActive' in currentUserDoc()) || currentUserDoc().isActive == true);
    }
    function isActiveUser() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && (!('isActive' in currentUserDoc()) || currentUserDoc().isActive == true);
    }

    // ── users: identity + role. This must be locked down first — every
    // isAdmin() check in this file reads from here, so a writable `role`
    // field would make every other admin-only rule below meaningless. ────
      match /users/{userId} {
      allow read: if isSignedIn() && (isAdmin() || request.auth.uid == userId);

      // Only an admin creates profiles. Self-registration is closed, so a
      // stranger who signs up through the public API gets no data access.
      allow create: if isAdmin()
        && request.resource.data.role in ['admin', 'employee']
        && request.resource.data.isActive is bool;

      // Admins may change anything. A user editing their own doc may not
      // touch role/isActive on themselves.
      allow update: if isAdmin()
        || (isSignedIn() && request.auth.uid == userId
            && request.resource.data.role == resource.data.role
            && request.resource.data.isActive == resource.data.isActive);

      allow delete: if isAdmin();
    }

    // ── employees: salary + personal contact info. Admin-only end to end.
    // Technician-assignment/filter dropdowns read from the separate
    // employee_directory mirror instead (see below), so non-admin users
    // never need direct access to this collection. ───────────────────────
    match /employees/{employeeId} {
      allow read, write: if isAdmin();
    }

    // Public, non-sensitive mirror (name + status only — no salary, phone,
    // email or address) kept in sync by the app whenever an employee is
    // added or edited. Readable by any signed-in user.
    match /employee_directory/{employeeId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // ── Operational collections: any active staff member (admin or
    // employee) can work with them; sensitive actions stay admin-only. ──
    match /customers/{customerId} {
      allow read, create, update: if isActiveUser();
      allow delete: if isAdmin();
    }

    match /installations/{installationId} {
      allow read, create, update: if isActiveUser();
      allow delete: if isAdmin();
    }

    match /packages/{packageId} {
      allow read: if isActiveUser();
      allow write: if isAdmin();
    }

    match /payments/{paymentId} {
      allow read, create: if isActiveUser();
      allow update, delete: if isAdmin();
    }

    match /inventory/{itemId} {
      allow read, update: if isActiveUser();
      allow create, delete: if isAdmin();

      match /movements/{movementId} {
        allow read, create: if isActiveUser();
        allow update, delete: if isAdmin();
      }
    }

    match /stock_issues/{issueId} {
      allow read, create: if isActiveUser();
      allow update, delete: if isAdmin();
    }

    match /expenses/{expenseId} {
      allow read, write: if isAdmin();
    }

    match /suppliers/{supplierId} {
      allow read, write: if isAdmin();
    }

    match /supplier_purchases/{purchaseId} {
      allow read, write: if isAdmin();
    }

    match /supplier_payments/{paymentId} {
      allow read, write: if isAdmin();
    }

    match /app_settings/{docId} {
      allow read: if isSignedIn();
      // Auto-created with defaults on first read if missing (see
      // SettingsRemoteDataSource.getSettings) — allow that one-time create
      // for any signed-in user; further edits require admin.
      allow create: if isSignedIn();
      allow update, delete: if isAdmin();
    }

       match /complaints/{complaintId} {

      function validStatus(s) {
        return s in ['open', 'inProgress', 'resolved', 'closed'];
      }

      // Resolving or closing a complaint requires resolution notes.
      function resolvedHasNotes() {
        return !(request.resource.data.status in ['resolved', 'closed'])
          || (request.resource.data.resolutionNotes is string
              && request.resource.data.resolutionNotes.size() > 0);
      }

      // Admin sees everything. An active employee sees only complaints
      // assigned to them.
      allow read: if isAdmin()
        || (isActiveUser()
            && resource.data.get('assignedEmployeeId', null) == request.auth.uid);

      // Only admins create complaints.
      allow create: if isAdmin() && validStatus(request.resource.data.status);

      // Admin can edit everything. The assigned employee can change only
      // status, resolution notes and timestamps.
      allow update: if (isAdmin()
            && validStatus(request.resource.data.status)
            && resolvedHasNotes())
        || (isActiveUser()
            && resource.data.get('assignedEmployeeId', null) == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['status', 'resolutionNotes', 'resolvedAt', 'updatedAt'])
            && validStatus(request.resource.data.status)
            && resolvedHasNotes());

      allow delete: if isAdmin();
    }

    // Deny anything not explicitly matched above.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
